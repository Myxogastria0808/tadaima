{
  "name": "tadaima-workspace",
  "private": true,
  "scripts": {
    "setup": "pnpm install && pnpm run ags:types && pnpm run wiki:build",
    "fmt": "oxfmt --write '!**/*.astro' . && pnpm -C wiki exec prettier --write '**/*.astro'",
    "fmt:check": "oxfmt --check '!**/*.astro' . && pnpm -C wiki exec prettier --check '**/*.astro'",
    "lint": "oxlint --fix --ignore-pattern '**/*.astro' . && pnpm -C wiki exec eslint --fix .",
    "lint:check": "oxlint --ignore-pattern '**/*.astro' . && pnpm -C wiki exec eslint .",
    "tadaima:pub": "pnpm -C packages/tadaima pub",
    "tadaima:unpub": "pnpm -C packages/tadaima unpub",
    "tadaima:typedoc:build": "pnpm -C packages/tadaima typedoc:build",
    "tadaima:typedoc:preview": "pnpm -C packages/tadaima typedoc:preview",
    "create-tadaima:pub": "pnpm -C packages/create-tadaima pub",
    "create-tadaima:unpub": "pnpm -C packages/create-tadaima unpub",
    "create-tadaima:typedoc:build": "pnpm -C packages/create-tadaima typedoc:build",
    "create-tadaima:typedoc:preview": "pnpm -C packages/create-tadaima typedoc:preview",
    "create-tadaima:dev": "pnpm -C packages/create-tadaima dev",
    "create-tadaima:build": "pnpm -C packages/create-tadaima build",
    "create-tadaima:start": "pnpm -C packages/create-tadaima start",
    "create-tadaima:test": "pnpm -C packages/create-tadaima test",
    "wiki:dev": "pnpm -C wiki dev",
    "wiki:start": "pnpm -C wiki start",
    "wiki:build": "pnpm -C wiki build",
    "wiki:preview": "pnpm -C wiki preview",
    "wiki:astro": "pnpm -C wiki astro",
    "docs:dev": "pnpm run tadaima:typedoc:build && pnpm run create-tadaima:typedoc:build && cp -r ./packages/tadaima/docs ./docs/tadaima && cp -r ./packages/create-tadaima/docs ./docs/create-tadaima && browser-sync start --server docs",
    "ags:types": "sh scripts/types.sh",
    "nix:build:minimal": "sh scripts/build.sh minimal",
    "nix:build:simple": "sh scripts/build.sh simple",
    "nix:build:image": "sh scripts/build.sh image",
    "nix:build:movie": "sh scripts/build.sh movie",
    "nix:build": "sh scripts/build.sh"
  },
  "devDependencies": {
    "browser-sync": "catalog:typedoc",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "packageManager": "pnpm@10.33.0"
}


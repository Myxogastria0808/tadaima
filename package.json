{
  "name": "tadaima-workspace",
  "private": true,
  "scripts": {
    "setup": "pnpm install && sh scripts/types.sh && pnpm run wiki:build",
    "types": "sh scripts/types.sh",
    "package:pub": "pnpm -C package pub",
    "package:unpub": "pnpm -C package unpub",
    "typedoc:build": "pnpm -C package typedoc:build",
    "typedoc:preview": "pnpm -C package typedoc:preview",
    "wiki:dev": "pnpm -C docs/wiki dev",
    "wiki:start": "pnpm -C docs/wiki start",
    "wiki:build": "pnpm -C docs/wiki build",
    "wiki:preview": "pnpm -C docs/wiki preview",
    "wiki:astro": "pnpm -C docs/wiki astro",
    "nix:build:simple": "sh scripts/build.sh simple",
    "nix:build:image": "sh scripts/build.sh image",
    "nix:build:movie": "sh scripts/build.sh movie"
  },
  "packageManager": "pnpm@10.33.0"
}


  "description": "A greetd greeter library for AGS/GJS",
  "keywords": [
    "ags",
    "gjs",
    "greetd",
    "greeter",
    "gtk4",
    "login",
    "wayland"
  ],
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Myxogastria0808/tadaima"
  },
  "files": [
    "LICENSE",
    "README.md",
    "src/"
  ],
  "type": "module",
